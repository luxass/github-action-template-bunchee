  "dependencies": {
    "@actions/core": "catalog:runtime"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "bunchee": "catalog:dev",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "oxlint-tsgolint": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "packageManager": "pnpm@12.17.0"
